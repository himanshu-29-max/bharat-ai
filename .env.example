# Bharat AI Environment Variables Example
# Do not place real secrets or API keys in this file.
# Copy to .env.local for local development, or add in Vercel project environment settings.

GROQ_API_KEY=
# Nov 2026: llama-3.3-70b-versatile / llama-3.1-8b-instant Groq ke free/developer plans se hat gaye hain.
# Khali chhodo to code khud openai/gpt-oss-120b -> openai/gpt-oss-20b try karega.
GROQ_MODEL=
GEMINI_API_KEY=
# Nov 2026: gemini-1.5-flash band ho gaya hai, gemini-2.5-flash naye users ke liye band hai.
# Khali chhodo to code khud gemini-3.8-flash -> gemini-3.6-flash -> gemini-3.5-flash-lite try karega.
GEMINI_MODEL=
# Optional FREE alternative provider (OpenRouter) - teesra fallback. Key: https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
TAVILY_API_KEY=
SERPER_API_KEY=

# Authentication Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_ID=
GITHUB_SECRET=

AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

APPLE_ID=
APPLE_SECRET=

NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Database & Cache
# DHYAAN: Upstash Console ke "REST API" section wala https:// URL + token hi dalna hai.
# redis:// se shuru hone wali connection string yahan NAHI chalegi (history "fetch failed" degi).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Access Control & Contact
ADMIN_EMAILS=
NEXT_PUBLIC_CONTACT_EMAIL=
